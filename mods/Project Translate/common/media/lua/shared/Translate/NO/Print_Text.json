{
  "Print_Text_Fortune10_info": "'Litt etter litt kommer man langt.'",
  "Print_Text_Fortune10_title": "Lykkespådom",
  "Print_Text_Fortune1_info": "'Erfaring er livets beste lærer.'",
  "Print_Text_Fortune1_title": "Lykkespådom",
  "Print_Text_Fortune2_info": "'Lev denne dagen som om den var din siste.'",
  "Print_Text_Fortune2_title": "Lykkespådom",
  "Print_Text_Fortune3_info": "'Det finnes ingen anger i livet. Bare lærdom.'",
  "Print_Text_Fortune3_title": "Lykkespådom",
  "Print_Text_Fortune4_info": "'La deg selv drømme igjen.'",
  "Print_Text_Fortune4_title": "Lykkespådom",
  "Print_Text_Fortune5_info": "'Gjør sårene dine om til visdom.'",
  "Print_Text_Fortune5_title": "Lykkespådom",
  "Print_Text_Fortune6_info": "'Se hvor langt du har kommet.'",
  "Print_Text_Fortune6_title": "Lykkespådom",
  "Print_Text_Fortune7_info": "'Pass deg for Nissehunden.'",
  "Print_Text_Fortune7_title": "Lykkespådom",
  "Print_Text_Fortune8_info": "'Hva er vitsen med å være til hvis du ikke er deg selv?'",
  "Print_Text_Fortune8_title": "Lykkespådom",
  "Print_Text_Fortune9_info": "'Hva nytter vinger uten motet til å fly.'",
  "Print_Text_Fortune9_title": "Lykkespådom"
}