{
  "Print_Text_Fortune10_info": "'Pouco a pouco, vai-se longe.'",
  "Print_Text_Fortune10_title": "Mensagem da Sorte",
  "Print_Text_Fortune1_info": "'A experiência é a melhor professora da vida.'",
  "Print_Text_Fortune1_title": "Mensagem da Sorte",
  "Print_Text_Fortune2_info": "'Viva este dia como se fosse o último.'",
  "Print_Text_Fortune2_title": "Mensagem da Sorte",
  "Print_Text_Fortune3_info": "'Não existem arrependimentos na vida. Apenas lições.'",
  "Print_Text_Fortune3_title": "Mensagem da Sorte",
  "Print_Text_Fortune4_info": "'Permita-se sonhar novamente.'",
  "Print_Text_Fortune4_title": "Mensagem da Sorte",
  "Print_Text_Fortune5_info": "'Transforme suas feridas em sabedoria.'",
  "Print_Text_Fortune5_title": "Mensagem da Sorte",
  "Print_Text_Fortune6_info": "'Veja o quão longe você chegou.'",
  "Print_Text_Fortune6_title": "Mensagem da Sorte",
  "Print_Text_Fortune7_info": "'Cuidado com o Cão Duende.'",
  "Print_Text_Fortune7_title": "Mensagem da Sorte",
  "Print_Text_Fortune8_info": "'Qual é o sentido de existir se você não for você mesmo?'",
  "Print_Text_Fortune8_title": "Mensagem da Sorte",
  "Print_Text_Fortune9_info": "'De que servem asas sem coragem para voar?'",
  "Print_Text_Fortune9_title": "Mensagem da Sorte"
