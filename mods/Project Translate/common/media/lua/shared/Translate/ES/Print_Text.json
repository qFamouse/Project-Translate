{
  "Print_Text_Fortune10_info": "'Poco a poco, se llega lejos.'",
  "Print_Text_Fortune10_title": "Mensaje de la fortuna",
  "Print_Text_Fortune1_info": "'La experiencia es la mejor maestra de la vida.'",
  "Print_Text_Fortune1_title": "Mensaje de la fortuna",
  "Print_Text_Fortune2_info": "'Vive este día como si fuera el último.'",
  "Print_Text_Fortune2_title": "Mensaje de la fortuna",
  "Print_Text_Fortune3_info": "'En la vida no hay arrepentimientos. Solo lecciones.'",
  "Print_Text_Fortune3_title": "Mensaje de la fortuna",
  "Print_Text_Fortune4_info": "'Permítete volver a soñar.'",
  "Print_Text_Fortune4_title": "Mensaje de la fortuna",
  "Print_Text_Fortune5_info": "'Convierte tus heridas en sabiduría.'",
  "Print_Text_Fortune5_title": "Mensaje de la fortuna",
  "Print_Text_Fortune6_info": "'Mira lo lejos que has llegado.'",
  "Print_Text_Fortune6_title": "Mensaje de la fortuna",
  "Print_Text_Fortune7_info": "'Cuidado con el Perro Duende.'",
  "Print_Text_Fortune7_title": "Mensaje de la fortuna",
  "Print_Text_Fortune8_info": "'¿De qué sirve existir si no eres tú mismo?'",
  "Print_Text_Fortune8_title": "Mensaje de la fortuna",
  "Print_Text_Fortune9_info": "'¿De qué sirven las alas sin el valor para volar?'",
  "Print_Text_Fortune9_title": "Mensaje de la fortuna"
}