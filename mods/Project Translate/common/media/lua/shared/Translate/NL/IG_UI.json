  "IGUI_PK42_IntrusiveThought6": "Laat er eentje je bijten, gewoon om het uit te proberen.",
  "IGUI_PK42_IntrusiveThought7": "Ik zou gewoon... mijn armen eraf kunnen rukken.",
  "IGUI_PK42_IntrusiveThought8": "Ik vraag me af wat ik met hun huid zou kunnen doen...",
  "IGUI_PK42_IntrusiveThought9": "Ik wil hun bloed drinken. Wacht. Moet ik hun bloed drinken?",
  "IGUI_PK42_Skeleton": "Menselijk skelet",
  "IGUI_PK42_TaintedMeat": "Zombievlees",
  "IGUI_PlayerText_BecameCannibalist": "Oh man! Ik heb de smaak van mensenvlees te pakken!",
  "IGUI_PlayerText_BecameDesensitized": "Ik denk... dat ik eraan gewend ben geraakt. Niets maakt me bang. Niets stoort me.",
  "IGUI_PlayerText_BecamePsychopath": "Dit gevoel... Het voelt... Ik voel me gelukkig als ik dood. Ik hou van het einde van de wereld!",
  "IGUI_PlayerText_OnFrenzyStart1": "Goed dan... speeltijd!",
  "IGUI_PlayerText_OnFrenzyStart10": "Ik zou nu een auto kunnen optillen.",
  "IGUI_PlayerText_OnFrenzyStart11": "Pijn? Welke pijn?",
  "IGUI_PlayerText_OnFrenzyStart2": "Oh, hier ga ik van genieten...",
  "IGUI_PlayerText_OnFrenzyStart3": "Het gebeurt weer...",
  "IGUI_PlayerText_OnFrenzyStart4": "Laten we de muren verven!",
  "IGUI_PlayerText_OnFrenzyStart5": "Laten we de grond rood verven!",
  "IGUI_PlayerText_OnFrenzyStart6": "Poepen jullie al in jullie broek?",
  "IGUI_PlayerText_OnFrenzyStart7": "Het wordt hier zo meteen plasbroekenstad!",
  "IGUI_PlayerText_OnFrenzyStart8": "Ik hoop dat jullie je poepbroek aan hebben!",
  "IGUI_PlayerText_OnFrenzyStart9": "Mijn handen trillen niet eens.",
  "IGUI_PlayerText_OnHitZombie1": "Dit kan ik de hele dag doen.",
  "IGUI_PlayerText_OnHitZombie10": "Hier heb ik op gewacht.",
  "IGUI_PlayerText_OnHitZombie11": "Doet het pijn? Dat hoort ook.",
  "IGUI_PlayerText_OnHitZombie12": "Je maakt het me te makkelijk.",
  "IGUI_PlayerText_OnHitZombie13": "Dit gaf me altijd een goed gevoel.",
  "IGUI_PlayerText_OnHitZombie14": "Het bloed vliegt in het rond. Ik hou ervan.",
  "IGUI_PlayerText_OnHitZombie15": "Die was voor mij.",
  "IGUI_PlayerText_OnHitZombie16": "Prachtig.",
  "IGUI_PlayerText_OnHitZombie17": "Ik vraag me af of je nog iets voelt.",
  "IGUI_PlayerText_OnHitZombie18": "Je vecht niet terug. Dat is teleurstellend.",
  "IGUI_PlayerText_OnHitZombie19": "Sst.",
  "IGUI_PlayerText_OnHitZombie2": "Voel je dat?",
  "IGUI_PlayerText_OnHitZombie20": "Dit had ik jaren geleden al moeten doen.",
  "IGUI_PlayerText_OnHitZombie3": "Dat klonk lekker.",
  "IGUI_PlayerText_OnHitZombie4": "Dat heb ik ooit bij een hond gedaan.",
  "IGUI_PlayerText_OnHitZombie5": "Nog een keer.",
  "IGUI_PlayerText_OnHitZombie6": "Blijf stil staan.",
  "IGUI_PlayerText_OnHitZombie7": "Dit is het beste deel.",
  "IGUI_PlayerText_OnHitZombie8": "Oh, je beweegt nog. Interessant.",
  "IGUI_PlayerText_OnHitZombie9": "Kom op, geef wat tegenstand.",
  "IGUI_PlayerText_OnKillPlayer1": "Je had ooit een naam. Grappig.",
  "IGUI_PlayerText_OnKillPlayer10": "Hm. Je hield het langer vol dan ik verwachtte.",
  "IGUI_PlayerText_OnKillPlayer11": "Sorry. Nee, niet echt.",
  "IGUI_PlayerText_OnKillPlayer12": "Ik had hier al een tijdje over nagedacht.",
  "IGUI_PlayerText_OnKillPlayer13": "Tenminste één van ons heeft plezier.",
  "IGUI_PlayerText_OnKillPlayer14": "De wereld heeft nu één probleem minder.",
  "IGUI_PlayerText_OnKillPlayer15": "Adem. Oh wacht.",
  "IGUI_PlayerText_OnKillPlayer16": "Je had hier niet moeten komen.",
  "IGUI_PlayerText_OnKillPlayer17": "Het is geen moord als niemand kijkt.",
  "IGUI_PlayerText_OnKillPlayer18": "Doe God de groeten van me.",
  "IGUI_PlayerText_OnKillPlayer19": "Rommelig. Maar het was het waard.",
  "IGUI_PlayerText_OnKillPlayer2": "Mensen zijn zo breekbaar.",
  "IGUI_PlayerText_OnKillPlayer20": "Weet je wat? Dat had ik nodig.",
  "IGUI_PlayerText_OnKillPlayer3": "Ik had dit gemist.",
  "IGUI_PlayerText_OnKillPlayer4": "Neem het niet persoonlijk.",
  "IGUI_PlayerText_OnKillPlayer5": "Je keek me verkeerd aan.",
  "IGUI_PlayerText_OnKillPlayer6": "Je had thuis moeten blijven.",
  "IGUI_PlayerText_OnKillPlayer7": "Ik neem je spullen. Je hebt ze toch niet meer nodig.",
  "IGUI_PlayerText_OnKillPlayer8": "Niets persoonlijks. Nou... misschien een beetje.",
  "IGUI_PlayerText_OnKillPlayer9": "Die schreeuw was muziek.",
  "IGUI_PlayerText_OnKillZombie1": "Blijf dit keer liggen.",
  "IGUI_PlayerText_OnKillZombie10": "Ruik die ingewanden. MOOI!",
  "IGUI_PlayerText_OnKillZombie11": "Zie je, zo doe je dat.",
  "IGUI_PlayerText_OnKillZombie12": "Schoon.",
  "IGUI_PlayerText_OnKillZombie13": "Dat voelde... gewoon... goed.",
  "IGUI_PlayerText_OnKillZombie14": "Graag gedaan.",
  "IGUI_PlayerText_OnKillZombie15": "Dat was leuk.",
  "IGUI_PlayerText_OnKillZombie16": "Dat voelt niet beter dan dit.",
  "IGUI_PlayerText_OnKillZombie17": "God, wat hou ik hiervan.",
  "IGUI_PlayerText_OnKillZombie18": "Dit is THERAPIE!",
  "IGUI_PlayerText_OnKillZombie19": "Dit kan ik de hele dag doen.",
  "IGUI_PlayerText_OnKillZombie2": "En daar ga je.",
  "IGUI_PlayerText_OnKillZombie20": "Sst. Het is voorbij.",
  "IGUI_PlayerText_OnKillZombie3": "Ik kan niet stoppen met glimlachen.",
  "IGUI_PlayerText_OnKillZombie4": "Ik moet dit vaker doen.",
  "IGUI_PlayerText_OnKillZombie5": "Eén minder.",
  "IGUI_PlayerText_OnKillZombie6": "Hm. Bevredigend.",
  "IGUI_PlayerText_OnKillZombie7": "Je was toch al dood.",
  "IGUI_PlayerText_OnKillZombie8": "Ik zal me je met plezier herinneren.",
  "IGUI_PlayerText_OnKillZombie9": "De volgende.",
